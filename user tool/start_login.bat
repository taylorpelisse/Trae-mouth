@echo off
chcp 65001 >nul
setlocal EnableExtensions
cd /d "%~dp0"

set "PYTHONIOENCODING=utf-8"
set "PYTHONUTF8=1"
set "RELAY=%~1"
if "%RELAY%"=="" set "RELAY=%TRAE_MOUTH_RELAY%"
if "%RELAY%"=="" set "RELAY=http://127.0.0.1:18792"
set "CODE=%~2"

echo ============================================================
echo  Trae Mouth login helper
echo  Relay: %RELAY%
echo ============================================================
echo.

where python >nul 2>nul
if not errorlevel 1 (
    set "PY=python"
) else (
    where py >nul 2>nul
    if errorlevel 1 (
        echo [x] Python 3 not found. Install Python 3.10+ and enable "Add Python to PATH".
        pause
        exit /b 1
    )
    set "PY=py -3"
)

if "%CODE%"=="" (
    echo [i] No code supplied, the helper will load the one generated by the panel.
)

%PY% "%~dp0login_helper.py" --relay "%RELAY%" --code "%CODE%" %3 %4 %5 %6 %7 %8 %9
set "RC=%ERRORLEVEL%"
echo.
if not "%RC%"=="0" (
    echo [x] Helper exited with code %RC%
    pause
) else (
    echo [OK] Done
)
exit /b %RC%
