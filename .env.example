# 服务监听
TRAE_MOUTH_HOST=127.0.0.1
TRAE_MOUTH_PORT=18792
# 下游 OpenAI API Key，多个用逗号分隔；留空只允许本机回环访问
TRAE_MOUTH_API_KEY=

# 数据目录与数据库
TRAE_MOUTH_DATA_DIR=./data
# TRAE_MOUTH_DB_PATH=./data/trae_mouth.db

# 32 字节主密钥。留空会在 data/master.key 自动生成。
# 支持 base64: / hex: 前缀，或 64 位 hex。
# TRAE_MOUTH_MASTER_KEY=base64:...
# TRAE_MOUTH_MASTER_KEY_FILE=./data/master.key

# 管理员。留空则首次访问面板时创建。
TRAE_MOUTH_ADMIN_USERNAME=admin
# TRAE_MOUTH_ADMIN_PASSWORD=change-me-please

# 对外地址。反向代理/远程部署时填写，例如 https://trae.example.com
# TRAE_MOUTH_PUBLIC_BASE_URL=https://trae.example.com
TRAE_MOUTH_TRUST_PROXY=0
TRAE_MOUTH_COOKIE_SECURE=0

# 账号策略
TRAE_MOUTH_REFRESH_WINDOW=1800
# 原生 DeviceInfo 刷新：上游会校验 token 绑定的设备，未注册设备会 20403，默认关闭
TRAE_REFRESH_DEVICE_INFO=0
TRAE_MOUTH_REFRESH_INTERVAL=300
TRAE_MOUTH_DEFAULT_CONCURRENCY=2
TRAE_MOUTH_MODEL_CATALOG_TTL=300
TRAE_MOUTH_IMPORT_CODE_TTL=600
TRAE_MOUTH_ALLOW_LOCAL_IMPORT=1
# 会话粘性 TTL（秒）、失败换号上限、账号冷却（秒）
TRAE_MOUTH_CONVERSATION_AFFINITY_TTL=604800
TRAE_MOUTH_ACCOUNT_FAILOVER_LIMIT=2
TRAE_MOUTH_ACCOUNT_COOLDOWN=300
TRAE_MOUTH_PREWARM_CATALOGS=1
# 请求体上限（字节），默认 128MB
TRAE_MOUTH_MAX_REQUEST_BYTES=134217728

# 对话与工具
TRAE_MOUTH_REASONING_AS_CONTENT=1
TRAE_MOUTH_STRICT_TOOL_ARGS=1
TRAE_MOUTH_TOOL_RESULT_MAX_CHARS=120000
TRAE_MOUTH_HISTORY_MAX_CHARS=1200000
# 0 表示不按消息条数截断
TRAE_MOUTH_HISTORY_MAX_MESSAGES=0
TRAE_MOUTH_TOOL_DUPLICATE_WARNING=1
# 全局 IDE 开启时模型列表只显示 IDE
TRAE_MOUTH_GLOBAL_IDE=1
# 原生工具预留开关
TRAE_MOUTH_NATIVE_TOOLS=0

# Trae 上游
TRAE_AUTH_HOST=https://api.trae.cn
TRAE_CLIENT_ID=ono9krqynydwx5
TRAE_AUTH_URL=https://www.trae.cn/authorization
TRAE_WEB_ORIGIN=https://solo.trae.cn
TRAE_MODEL_GATEWAY=https://trae-api-cn.mchost.guru
TRAE_WEB_API_BASE=https://trae-api-cn.mchost.guru/api/remote/v1
TRAE_LOGIN_PLUGIN_VERSION=2.3.24254
TRAE_LOGIN_APP_VERSION=0.1.7
TRAE_NATIVE_APP_VERSION=2.3.105403
# 官方 IDE 版本头；20261118 的目录才包含 1M __max 变体
TRAE_IDE_VERSION=3.4.22
TRAE_IDE_VERSION_CODE=20261118

TRAE_MOUTH_LOG_LEVEL=INFO
